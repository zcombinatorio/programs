
action "lending_liquidity_added" "svm::deploy_subgraph" {
    program_id = action.deploy_lending.program_id
    program_idl = action.deploy_lending.program_idl
    block_height = 0 // action.deploy_lending.block_height
    event {
        name = "LiquidityAdded"
    }
}

